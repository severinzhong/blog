---
import { getCollection } from 'astro:content';
import { formatPostSlug, withBase } from '../../lib/site';

interface RedirectMap {
	zh?: string;
	en?: string;
}

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	const grouped = new Map<string, RedirectMap>();

	for (const post of posts) {
		const current = grouped.get(post.data.translationKey) ?? {};
		current[post.data.language] = withBase(
			`/${post.data.language}/posts/${formatPostSlug(post.id, post.data.language)}/`,
		);
		grouped.set(post.data.translationKey, current);
	}

	return Array.from(grouped.entries()).map(([translationKey, redirectMap]) => ({
		params: { translationKey },
		props: { redirectMap },
	}));
}

const { redirectMap } = Astro.props as { redirectMap: RedirectMap };
const fallback = redirectMap.en ?? redirectMap.zh ?? withBase('/');
const fallbackRoot = withBase('/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0;url=${fallback}`} />
		<title>Redirecting…</title>
	</head>
	<body>
		<p>Redirecting to the best available language version...</p>
		<script is:inline define:vars={{ redirectMap, fallbackRoot }}>
			const preferred = (navigator.language || '').toLowerCase().startsWith('zh') ? 'zh' : 'en';
			const target = redirectMap[preferred] || redirectMap.en || redirectMap.zh || fallbackRoot;
			window.location.replace(target);
		</script>
	</body>
</html>
