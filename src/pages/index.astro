---
import BaseHead from '../components/BaseHead.astro';
import { SITE_META, withBase } from '../lib/site';

const fallbackUrl = withBase('/en/');
const basePath = withBase('/');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_META.title} description={SITE_META.description} />
		<meta http-equiv="refresh" content={`0;url=${fallbackUrl}`} />
	</head>
	<body>
		<main>
			<h1>Redirecting...</h1>
			<p>We are redirecting you to the preferred language.</p>
			<ul>
				<li><a href={withBase('/zh/')}>中文</a></li>
				<li><a href={withBase('/en/')}>English</a></li>
			</ul>
		</main>
		<script is:inline define:vars={{ basePath }}>
			const lang = (navigator.language || '').toLowerCase();
			const locale = lang.startsWith('zh') ? 'zh' : 'en';
			window.location.replace(`${basePath}${locale}/`);
		</script>
	</body>
</html>

<style>
	main {
		max-width: 680px;
		padding-top: 6rem;
		text-align: center;
	}
	ul {
		list-style: none;
		padding: 0;
		display: flex;
		gap: 0.9rem;
		justify-content: center;
	}
	li a {
		display: inline-block;
		padding: 0.6rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
	}
</style>
