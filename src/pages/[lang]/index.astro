---
import { getCollection, getEntries } from 'astro:content';
import ProjectStatus from '../../components/ProjectStatus.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getProjectStatus } from '../../lib/project-status';
import { formatPostSlug, isLocale, LOCALES, NAV_COPY } from '../../lib/site';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!lang || !isLocale(lang)) {
	throw new Error(`Invalid locale: ${lang}`);
}

const copy = NAV_COPY[lang];
const posts = (await getCollection('posts', ({ data }) => data.language === lang && !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const recentPosts = await Promise.all(
	posts.slice(0, 6).map(async (post) => {
		const authorEntries = await getEntries(post.data.authors);
		return {
			post,
			authors: authorEntries.map((entry) => entry.data.name).join(', '),
		};
	}),
);

const projectStatus = await getProjectStatus();
const pageTitle = lang === 'zh' ? '博客首页' : 'Blog Home';
const pageDescription =
	lang === 'zh'
		? '多作者、双语博客，聚焦 AI 与数字产品实践。'
		: 'A bilingual multi-author blog focused on AI and digital product practice.';
---

<SiteLayout title={pageTitle} description={pageDescription} locale={lang} localizedRoute={true}>
	<h1>{lang === 'zh' ? '最新内容' : 'Latest Updates'}</h1>
	<p>
		{lang === 'zh'
			? '这是站点第一版，支持多作者、双语路由，并在构建时同步 GitHub 项目动态。'
			: 'This first version supports multi-author content, bilingual routes, and build-time GitHub project sync.'}
	</p>
	<section>
		<h2>{copy.latestPosts}</h2>
		<ul class="post-list">
			{recentPosts.map(({ post, authors }) => (
				<li>
					<a href={`/${lang}/posts/${formatPostSlug(post.id, lang)}/`}>{post.data.title}</a>
					<p>{post.data.summary}</p>
					<small>
						{new Date(post.data.publishedAt).toLocaleDateString()} · {authors}
					</small>
				</li>
			))}
		</ul>
		<p><a href={`/${lang}/posts/`}>{copy.readMore} →</a></p>
	</section>
	<ProjectStatus locale={lang} projectStatus={projectStatus} />
</SiteLayout>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.8rem;
	}
	.post-list li {
		padding: 0.85rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: #fff;
	}
	.post-list li p {
		margin: 0.3rem 0;
		font-size: 0.95rem;
	}
	.post-list li small {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
</style>
