---
import { type CollectionEntry, getCollection, getEntries, render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { formatPostSlug, isLocale, LOCALES } from '../../../lib/site';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	const paths: { params: { lang: string; slug: string }; props: { post: CollectionEntry<'posts'> } }[] = [];

	for (const locale of LOCALES) {
		for (const post of posts) {
			if (post.data.language !== locale) {
				continue;
			}
			paths.push({
				params: {
					lang: locale,
					slug: formatPostSlug(post.id, locale),
				},
				props: { post },
			});
		}
	}

	return paths;
}

const lang = Astro.params.lang;
if (!lang || !isLocale(lang)) {
	throw new Error(`Invalid locale: ${lang}`);
}

const { post } = Astro.props;
const { Content } = await render(post);
const authorEntries = await getEntries(post.data.authors);
---

<SiteLayout title={post.data.title} description={post.data.summary} locale={lang} localizedRoute={true}>
	<article class="post-detail">
		<p class="meta">
			{new Date(post.data.publishedAt).toLocaleDateString()} · {authorEntries.map((entry) => entry.data.name).join(', ')}
		</p>
		<h1>{post.data.title}</h1>
		<p>{post.data.summary}</p>
		<p class="meta">Tags: {post.data.tags.join(', ')}</p>
		{post.data.updatedAt && (
			<p class="meta">Updated: {new Date(post.data.updatedAt).toLocaleDateString()}</p>
		)}
		<hr />
		<Content />
	</article>
	<section>
		<h2>{lang === 'zh' ? '作者' : 'Authors'}</h2>
		<ul class="authors">
			{authorEntries.map((entry) => (
				<li>
					<strong>{entry.data.name}</strong>
					<p>{entry.data.role}</p>
					<p>{entry.data.bio}</p>
					{entry.data.github && (
						<p>
							<a href={`https://github.com/${entry.data.github}`} target="_blank" rel="noreferrer">
								@{entry.data.github}
							</a>
						</p>
					)}
				</li>
			))}
		</ul>
	</section>
	<p><a href={`/${lang}/posts/`}>← {lang === 'zh' ? '返回文章列表' : 'Back to posts'}</a></p>
</SiteLayout>

<style>
	.post-detail .meta {
		font-size: 0.82rem;
		color: rgb(var(--gray));
		margin-bottom: 0.45rem;
	}

	.authors {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.8rem;
	}

	.authors li {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 0.8rem;
		background: #fff;
	}

	.authors p {
		margin: 0.2rem 0;
		font-size: 0.95rem;
	}
</style>
