---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase, type Locale } from '../lib/site';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	localizedRoute?: boolean;
}

const { title, description, locale, localizedRoute = false } = Astro.props;
const normalizedBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathnameWithoutBase =
	normalizedBase && Astro.url.pathname.startsWith(normalizedBase)
		? Astro.url.pathname.slice(normalizedBase.length) || '/'
		: Astro.url.pathname;
const normalizedPath = pathnameWithoutBase.replace(/^\/(zh|en)(\/|$)/, '/');
const zhPath = withBase(`/zh${normalizedPath === '/' ? '/' : normalizedPath}`);
const enPath = withBase(`/en${normalizedPath === '/' ? '/' : normalizedPath}`);
const defaultPath = withBase('/');
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} />
		{
			localizedRoute && (
				<>
					<link rel="alternate" hrefLang="zh-CN" href={new URL(zhPath, Astro.site)} />
					<link rel="alternate" hrefLang="en" href={new URL(enPath, Astro.site)} />
					<link rel="alternate" hrefLang="x-default" href={new URL(defaultPath, Astro.site)} />
				</>
			)
		}
	</head>
	<body>
		<SiteHeader locale={locale} />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
