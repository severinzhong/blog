---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<p>© {year} AI and Digital Notes</p>
	<p class="sub">Built with Astro and deployed on GitHub Pages.</p>
</footer>

<style>
	.site-footer {
		margin-top: 2.5rem;
		padding: 2.5rem 1rem 3rem;
		text-align: center;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		border-top: 1px solid rgb(var(--gray-light));
	}

	.sub {
		margin: 0.35rem 0 0;
	}
</style>
