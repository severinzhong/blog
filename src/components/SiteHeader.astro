---
import type { Locale } from '../lib/site';
import { NAV_COPY } from '../lib/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = NAV_COPY[locale];
---

<header class="site-header">
	<div class="container">
		<a class="brand" href="/">AI and Digital Notes</a>
		<nav>
			<a href={`/${locale}/`}>{copy.home}</a>
			<a href={`/${locale}/posts/`}>{copy.posts}</a>
			<a href="/about">{copy.about}</a>
		</nav>
		<div class="locale-switch">
			<a href="/zh/" aria-label="Chinese">ZH</a>
			<span>/</span>
			<a href="/en/" aria-label="English">EN</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		background: #fff;
	}

	.container {
		max-width: 980px;
		margin: 0 auto;
		padding: 0.9rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		color: rgb(var(--black));
	}

	nav {
		display: flex;
		gap: 0.85rem;
	}

	nav a {
		text-decoration: none;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}

	.locale-switch {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.82rem;
	}

	.locale-switch a {
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.container {
			flex-wrap: wrap;
		}
	}
</style>
